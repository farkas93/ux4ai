AIPM_INSTRUCTOR_USERNAME=instructor
AIPM_INSTRUCTOR_PASSWORD=replace-with-a-development-secret
AIPM_COURSE_NAME="AIPM Workshop"

# Optional Gitea/container registry publishing settings for gitea_release.sh
# and gitea_helm_release.sh. DOCKER_PASSWORD may be omitted after docker/helm
# registry login; do not commit a real .env file.
DOCKER_REGISTRY=gitea.example.org
DOCKER_USERNAME=your-gitea-user
HELM_OCI_NAMESPACE=your-gitea-user
# DOCKER_PASSWORD=
